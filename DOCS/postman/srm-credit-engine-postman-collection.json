{
  "info": {
    "name": "SRM Credit Engine",
    "description": "Coleção de testes para os endpoints do SRM Credit Engine (Passo 14 do plano). Requer a aplicação rodando em http://localhost:8080 (mvn spring-boot:run). Atualizada com os 3 serviços encontrados ao começar o frontend: simulação, Currency Engine e extrato analítico (ver DECISIONS.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "receivableId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "settlementId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Recebíveis",
      "item": [
        {
          "name": "Cadastrar recebível (Duplicata Mercantil, BRL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": 100000,\n  \"termMonths\": 3,\n  \"paymentCurrency\": \"BRL\",\n  \"cedente\": \"Fábrica XYZ\",\n  \"sacado\": \"Loja ABC\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables"]
            }
          }
        },
        {
          "name": "Cadastrar recebível (Cheque Pré-datado, USD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CHEQUE_PRE_DATADO\",\n  \"faceValue\": 25000,\n  \"termMonths\": 2,\n  \"paymentCurrency\": \"USD\",\n  \"cedente\": \"Comércio ABC\",\n  \"sacado\": \"Distribuidora DEF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables"]
            }
          }
        },
        {
          "name": "Cadastrar recebível inválido (deve retornar 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": -100,\n  \"termMonths\": 0,\n  \"paymentCurrency\": \"BRL\",\n  \"cedente\": \"\",\n  \"sacado\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables"]
            }
          }
        },
        {
          "name": "Buscar recebível por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/receivables/{{receivableId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables", "{{receivableId}}"]
            }
          }
        },
        {
          "name": "Buscar recebível inexistente (deve retornar 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/receivables/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables", "999999"]
            }
          }
        },
        {
          "name": "Listar todos os recebíveis",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/receivables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables"]
            }
          }
        }
      ]
    },
    {
      "name": "Simulação (novo)",
      "description": "POST /api/receivables/simulate -- calcula valor presente e deságio sem persistir nada. Usado pelo painel do operador para preview em tempo real (SPEC.md, Critério de Aceite 5).",
      "item": [
        {
          "name": "Simular recebível em BRL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": 100000,\n  \"termMonths\": 3,\n  \"paymentCurrency\": \"BRL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables", "simulate"]
            },
            "description": "Golden case C1 -- valor presente esperado: R$ 92.859,94. Confirma que a simulação bate com o mesmo resultado da liquidação real, já validado em GoldenCasesTest."
          }
        },
        {
          "name": "Simular recebível em USD (cross-currency, chama API real de câmbio)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": 100000,\n  \"termMonths\": 3,\n  \"paymentCurrency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables", "simulate"]
            },
            "description": "fxRateUsed vem preenchido na resposta (consulta real ao provedor de câmbio -- não é mockado)."
          }
        },
        {
          "name": "Simular com payload inválido (deve retornar 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": -50,\n  \"termMonths\": 0,\n  \"paymentCurrency\": \"BRL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/receivables/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "receivables", "simulate"]
            }
          }
        }
      ]
    },
    {
      "name": "Currency Engine (novo)",
      "description": "GET /api/exchange-rates/latest -- consulta a taxa vigente, sem escrita manual (ver SPEC.md, Seção 2, item 6).",
      "item": [
        {
          "name": "Consultar taxa vigente USD -> BRL",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/exchange-rates/latest?from=USD&to=BRL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exchange-rates", "latest"],
              "query": [
                { "key": "from", "value": "USD" },
                { "key": "to", "value": "BRL" }
              ]
            },
            "description": "Retorna rate, obtainedAt (timestamp de vigência) e providerName."
          }
        },
        {
          "name": "Consultar taxa vigente (usando defaults, sem query params)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/exchange-rates/latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exchange-rates", "latest"]
            },
            "description": "Sem from/to, usa os defaults do endpoint (USD -> BRL) -- mesmo resultado do request acima."
          }
        }
      ]
    },
    {
      "name": "Liquidações",
      "item": [
        {
          "name": "Liquidar em BRL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivableId\": {{receivableId}},\n  \"currency\": \"BRL\",\n  \"idempotencyKey\": \"teste-postman-brl-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            }
          }
        },
        {
          "name": "Liquidar em USD (cross-currency, chama API real de câmbio)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivableId\": {{receivableId}},\n  \"currency\": \"USD\",\n  \"idempotencyKey\": \"teste-postman-usd-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            }
          }
        },
        {
          "name": "Liquidar de novo com a MESMA chave (testa idempotência)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivableId\": {{receivableId}},\n  \"currency\": \"BRL\",\n  \"idempotencyKey\": \"teste-postman-brl-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            },
            "description": "Reenvia a MESMA idempotencyKey do primeiro request de liquidação BRL. Deve retornar o MESMO settlement (mesmo ID), não criar um novo -- prova a idempotência (Passo 12) via HTTP de verdade."
          }
        },
        {
          "name": "Liquidar recebível inexistente (deve retornar 404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivableId\": 999999,\n  \"currency\": \"BRL\",\n  \"idempotencyKey\": \"teste-postman-404\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            }
          }
        },
        {
          "name": "Liquidar recebível já liquidado (deve retornar 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivableId\": {{receivableId}},\n  \"currency\": \"BRL\",\n  \"idempotencyKey\": \"chave-diferente-vai-dar-409\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            },
            "description": "Chave DIFERENTE da primeira liquidação, mas o mesmo receivableId, que já está SETTLED. Deve retornar 409 (ReceivableAlreadySettledException), não confundir com o teste de idempotência acima."
          }
        },
        {
          "name": "Buscar liquidação por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements/{{settlementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements", "{{settlementId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Extrato Analítico (novo)",
      "description": "GET /api/settlements -- filtros opcionais e combináveis (cedente, currency, startDate, endDate) + paginação server-side (page/size). Requisito 4.1.6, Critério de Aceite 6 do SPEC.md.",
      "item": [
        {
          "name": "Extrato completo, sem filtro (página 0, tamanho padrão)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            }
          }
        },
        {
          "name": "Extrato filtrado por moeda (BRL)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements?currency=BRL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"],
              "query": [
                { "key": "currency", "value": "BRL" }
              ]
            }
          }
        },
        {
          "name": "Extrato filtrado por cedente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements?cedente=Fábrica XYZ",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"],
              "query": [
                { "key": "cedente", "value": "Fábrica XYZ" }
              ]
            },
            "description": "Filtro por nome EXATO do cedente -- ajuste o valor conforme o cedente que você cadastrou."
          }
        },
        {
          "name": "Extrato filtrado por período",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements?startDate=2026-01-01T00:00:00Z&endDate=2026-12-31T23:59:59Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"],
              "query": [
                { "key": "startDate", "value": "2026-01-01T00:00:00Z" },
                { "key": "endDate", "value": "2026-12-31T23:59:59Z" }
              ]
            },
            "description": "Formato ISO-8601. Ajuste as datas conforme quando suas liquidações de teste foram feitas."
          }
        },
        {
          "name": "Extrato paginado (página 0, 2 por página)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/settlements?page=0&size=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" }
              ]
            },
            "description": "Confirma paginação server-side: totalElements/totalPages na resposta devem refletir o total real, mesmo trazendo só 2 registros no 'content'."
          }
        }
      ]
    }
  ]
}